# Copy this file to .env to change settings. Never commit your real .env file.
# The AI explanation is OFF by default. The dashboard checkbox turns it on per session.

# Where the local model runs. Ollama's default address is below.
# Only localhost addresses are accepted unless LLM_ALLOW_REMOTE=true.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_TIMEOUT=60

# Leave this false. Setting it true allows sending findings to a non-local address.
LLM_ALLOW_REMOTE=false
